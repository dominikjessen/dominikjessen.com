type DoodleName = keyof typeof doodles;
const doodleNames = Object.keys(doodles) as DoodleName[];

// ── Scatter ─────────────────────────────────────────────────────────────────────

/** Small seeded PRNG (mulberry32), so the scatter is the same on every build. */
function seededRandom(seed: number): () => number {
  let state = seed;
  return () => {
    state = (state + 0x6d2b79f5) | 0;
    let t = Math.imul(state ^ (state >>> 15), 1 | state);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

const ROWS = 16;
const COLUMNS = 5;
/** Share of grid cells left empty, so the layout doesn't read as a grid. */
const EMPTY_CELL_CHANCE = 0.3;
const MIN_SIZE_PX = 34;
const MAX_SIZE_PX = 80;
const MAX_TILT_DEG = 35;

const random = seededRandom(20260914);

// Deal doodles like a shuffled deck: every kind appears once before any repeats.
let deck: DoodleName[] = [];
function nextDoodle(): DoodleName {
  if (deck.length === 0) {
    deck = [...doodleNames];
    for (let i = deck.length - 1; i > 0; i--) {
      const j = Math.floor(random() * (i + 1));
      [deck[i], deck[j]] = [deck[j], deck[i]];
    }
  }
  return deck.pop()!;
}

const scatter: {
  name: DoodleName;
  x: number;
  y: number;
  size: number;
  tilt: number;
  onPhones: boolean;
}[] = [];

for (let row = 0; row < ROWS; row++) {
  for (let column = 0; column < COLUMNS; column++) {
    if (random() < EMPTY_CELL_CHANCE) continue;
    scatter.push({
      name: nextDoodle(),
      // Somewhere inside the cell, never on its edge, so neighbours don't collide.
      x: ((column + 0.15 + random() * 0.7) / COLUMNS) * 100,
      y: ((row + 0.1 + random() * 0.8) / ROWS) * 100,
      size: Math.round(MIN_SIZE_PX + random() * (MAX_SIZE_PX - MIN_SIZE_PX)),
      tilt: Math.round(-MAX_TILT_DEG + random() * MAX_TILT_DEG * 2),
      // Phones get roughly half, so the narrow page doesn't get crowded.
      onPhones: random() < 0.5,
    });
  }
}
---

<div
  aria-hidden="true"
  class="pointer-events-none absolute inset-y-0 -left-[10%] -right-[10%] -z-10 overflow-hidden [--doodle-scale:0.75] md:[--doodle-scale:1]"
>
  {
    scatter.map(({ name, x, y, size, tilt, onPhones }) => {
      const { paths, rings = [], dots = [], brass = false } = doodles[name] as Doodle;
      // Visible at a glance but still clearly background (16% vanished on bright screens).
      const tone = brass
        ? 'text-brass opacity-[0.5] dark:opacity-[0.35]'
        : 'text-primary opacity-[0.28] dark:text-primary-muted dark:opacity-[0.24]';
      return (
        <svg
          viewBox="0 0 64 64"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          data-doodle={name}
          class={`absolute ${onPhones ? '' : 'hidden md:block'} ${tone}`}
          style={`left: ${x.toFixed(2)}%; top: ${y.toFixed(2)}%; width: calc(${size}px * var(--doodle-scale)); transform: translate(-50%, -50%) rotate(${tilt}deg);`}
        >
          {/* Same line weight at every size, so small and large doodles look drawn with one pen. */}
          {paths.map((d) => (
            <path d={d} vector-effect="non-scaling-stroke" />
          ))}
          {rings.map(([cx, cy, r]) => (
            <circle cx={cx} cy={cy} r={r} vector-effect="non-scaling-stroke" />
          ))}
          {dots.map(([cx, cy, r]) => (
            <circle cx={cx} cy={cy} r={r} fill="currentColor" stroke="none" />
          ))}
        </svg>
      );
    })
  }
</div>

<script>
  // Keep doodles out from behind text marked `data-keep-clear` (the masthead). Around it is fine.
  // Positions are percentages of a page whose height changes with the viewport, so this is measured
  // rather than baked into the scatter. Whole doodles are hidden, never clipped.
  const CLEARANCE_PX = 12;

  function clearDoodlesFromText(): void {
    const zones = [...document.querySelectorAll('[data-keep-clear]')].map((el) =>
      el.getBoundingClientRect()
    );
    document.querySelectorAll<SVGElement>('svg[data-doodle]').forEach((doodle) => {
      doodle.style.visibility = '';
      const box = doodle.getBoundingClientRect();
      const overlaps = zones.some(
        (zone) =>
          box.left < zone.right + CLEARANCE_PX &&
          box.right > zone.left - CLEARANCE_PX &&
          box.top < zone.bottom + CLEARANCE_PX &&
          box.bottom > zone.top - CLEARANCE_PX
      );
      if (overlaps) doodle.style.visibility = 'hidden';
    });
  }

  clearDoodlesFromText();
  // Re-check once web fonts settle (text widths change) and whenever the layout does.
  document.fonts?.ready.then(clearDoodlesFromText);
  window.addEventListener('resize', clearDoodlesFromText);
</script>
