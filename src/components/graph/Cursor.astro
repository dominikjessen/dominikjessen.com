---
import type { HTMLAttributes } from 'astro/types';

export interface Props extends HTMLAttributes<'div'> {
  name: string;
  color?: 'pine' | 'visitor';
}

// A collaborator cursor (arrow + name tag), as in a shared workflow file. Decorative; position it from outside.
const { name, color = 'pine', class: className, ...rest } = Astro.props as Props;
---

<div class:list={['flex items-start gap-px pointer-events-none', className]} aria-hidden="true" {...rest}>
  <svg width="18" height="20" viewBox="0 0 18 20" class="shrink-0">
    <path
      d="M1.5 1.5 L1.5 16 L5.4 12.4 L8.2 18.6 L10.9 17.4 L8.2 11.4 L13.6 11.4 Z"
      fill={`var(--${color})`}
      stroke="#ffffff"
      stroke-width="1.4"
      stroke-linejoin="round"></path>
  </svg>
  <span
    class:list={[
      'mt-[14px] px-2 py-[3px] rounded-[6px_6px_6px_2px] text-white text-xs font-semibold whitespace-nowrap',
      color === 'pine' ? 'bg-pine' : 'bg-visitor',
    ]}>{name}</span
  >
</div>
