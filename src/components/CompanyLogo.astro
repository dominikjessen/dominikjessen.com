---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

export interface Props {
  logo: string; // filename in src/images/companies/
  size?: number; // tile size in px; the logo scales with it
  className?: string;
  eager?: boolean; // set for logos above the fold (the hero graph)
}

const logos = import.meta.glob<{ default: ImageMetadata }>('../images/companies/*', { eager: true });

// Logo size inside a 40px tile. Some marks need more room than others to read at the same weight.
const sizeInTile: Record<string, number> = {
  sovanta: 36,
  n8n: 36,
  mannheim: 34,
  unilife: 34,
  tractable: 30,
  vesper: 24,
};

const { logo, size = 40, className, eager = false } = Astro.props as Props;

const key = Object.keys(logos).find((k) => k.endsWith(`/${logo}`));
if (!key) throw new Error(`CompanyLogo: no file "${logo}" in src/images/companies/`);

const name = logo.replace(/\.[^.]+$/, '');
const px = Math.round(((sizeInTile[name] ?? 32) * size) / 40);
---

<span
  class:list={['flex shrink-0 items-center justify-center overflow-hidden bg-white border border-charcoal/10', className]}
  style={`width:${size}px;height:${size}px`}
>
  <Image src={logos[key].default} alt="" width={px} height={px} densities={[1, 2]} loading={eager ? 'eager' : 'lazy'} class="object-contain" draggable="false" />
</span>
