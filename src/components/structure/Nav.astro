---

---

<header class="fixed z-50 w-full pointer-events-none">
  <div class="max-w-7xl mx-auto px-4 pt-3.5 md:px-10 md:pt-5 xl:px-18">
    <nav
      id="nav"
      class="relative pointer-events-auto flex items-center justify-between gap-4 bg-white border border-charcoal/14 rounded-xl py-1 pr-1 pl-4 md:pr-2 md:pl-5 shadow-[0_6px_18px_rgb(26_26_23/0.05)]"
    >
      <a href="/" data-ref="intro" class="flex items-center gap-3 rounded-md text-charcoal focus-visible:outline-2 focus-visible:outline-pine focus-visible:outline-offset-2">
        <span class="font-display text-[21px] md:text-2xl leading-none">Dominik Jessen</span>
        <span class="hidden md:inline font-mono text-label leading-none text-muted bg-chip rounded-md px-2 py-1">~/home</span>
      </a>
      <button
        type="button"
        id="nav-trigger"
        class="md:hidden flex items-center justify-center size-11 rounded-lg bg-chip text-charcoal focus-visible:outline-2 focus-visible:outline-pine focus-visible:outline-offset-2"
        aria-controls="nav-dropdown"
        aria-label="Open menu"
      >
        <svg class="size-5" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
          <path d="M3.5 6h13M3.5 10h13M3.5 14h8" />
        </svg>
      </button>
      <ul id="nav-links-desktop" class="hidden md:flex items-center gap-1 font-mono text-ui text-charcoal">
        <li><a href="/#projects" data-ref="projects" class="nav-link block px-3.5 py-3.25 rounded-lg">projects</a></li>
        <li><a href="/#work" data-ref="work" class="nav-link block px-3.5 py-3.25 rounded-lg">work</a></li>
        <li><a href="/#currently" data-ref="currently" class="nav-link block px-3.5 py-3.25 rounded-lg">about</a></li>
        <li>
          <a
            id="cv-nav"
            href="/CV_DominikJessen.pdf"
            data-ref="cv"
            target="_blank"
            rel="noopener noreferrer"
            class="nav-link block px-3.5 py-3.25 rounded-lg">cv</a
          >
        </li>
      </ul>
      <div
        id="nav-dropdown"
        class="hidden md:hidden absolute top-full left-0 right-0 mt-2 p-1 bg-white border border-charcoal/14 rounded-xl shadow-[0_6px_18px_rgb(26_26_23/0.05)]"
        aria-hidden="true"
      >
        <ul class="flex flex-col font-mono text-sm text-charcoal">
          <li><a href="/#projects" data-ref="projects" class="nav-link block px-4 py-3 rounded-lg">projects</a></li>
          <li><a href="/#work" data-ref="work" class="nav-link block px-4 py-3 rounded-lg">work</a></li>
          <li><a href="/#currently" data-ref="currently" class="nav-link block px-4 py-3 rounded-lg">about</a></li>
          <li>
            <a href="/CV_DominikJessen.pdf" data-ref="cv" target="_blank" rel="noopener noreferrer" class="nav-link block px-4 py-3 rounded-lg">cv</a>
          </li>
        </ul>
      </div>
    </nav>
  </div>
</header>

<style>
  .nav-link:hover,
  .nav-link.navitem-active {
    background-color: var(--chip);
  }

  .nav-link:focus-visible {
    outline: 2px solid var(--pine);
    outline-offset: 2px;
  }
</style>

<script>
  const nav = document.getElementById('nav');
  const navDropdown = document.getElementById('nav-dropdown');
  const navTrigger = document.getElementById('nav-trigger');

  /////////////////////
  // Active nav link //
  /////////////////////
  const sections = [...document.getElementsByTagName('section')];
  const footer = document.getElementById('footer');
  if (footer) {
    sections.push(footer);
  }

  function highlightSection(entry: IntersectionObserverEntry) {
    const id = entry.target.id;
    const currentlyActive = document.querySelectorAll('.navitem-active');
    const shouldBeActive = document.querySelectorAll(`#nav a[data-ref="${id}"]`);

    currentlyActive.forEach((el) => el.classList.remove('navitem-active'));
    shouldBeActive.forEach((el) => el.classList.add('navitem-active'));
  }

  const highlightCallback: IntersectionObserverCallback = (entries, _observer) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        highlightSection(entry);
      }
    });
  };
  const highlightIO = new IntersectionObserver(highlightCallback, { threshold: 0.25 });
  sections.forEach((section) => highlightIO.observe(section));

  //////////////////////
  // Nav click scroll //
  //////////////////////

  function onNavLinkClicked(e: Event, link: Element) {
    const targetId = link.getAttribute('data-ref') ?? '';
    if (targetId === 'cv') {
      if (navDropdown && navTrigger) {
        navDropdown.classList.add('hidden');
        navDropdown.setAttribute('aria-hidden', 'true');
        navTrigger.setAttribute('aria-expanded', 'false');
        navTrigger.setAttribute('aria-label', 'Open menu');
      }
      return;
    }

    const scrollTarget = document.getElementById(targetId);

    // Off the homepage the section isn't here, so let the link navigate to it.
    if (!scrollTarget || !nav) return;
    e.preventDefault();

    if (targetId === 'intro') {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    } else {
      const offset =
        scrollTarget.getBoundingClientRect().top + window.scrollY - (nav.getBoundingClientRect().height + 2 * nav.getBoundingClientRect().top);
      window.scrollTo({ top: offset, behavior: 'smooth' });
    }

    if (navDropdown && navTrigger) {
      navDropdown.classList.add('hidden');
      navDropdown.setAttribute('aria-hidden', 'true');
      navTrigger.setAttribute('aria-expanded', 'false');
      navTrigger.setAttribute('aria-label', 'Open menu');
    }
  }

  const navLinks = document.querySelectorAll('#nav a[data-ref]');
  navLinks.forEach((linkEl) => {
    linkEl.addEventListener('click', (e: Event) => {
      onNavLinkClicked(e, linkEl);
    });
  });

  //////////////////////
  // Mobile dropdown  //
  //////////////////////
  if (navTrigger && navDropdown) {
    navTrigger.setAttribute('aria-expanded', 'false');
    navTrigger.addEventListener('click', () => {
      const isOpen = !navDropdown.classList.contains('hidden');
      navDropdown.classList.toggle('hidden', isOpen);
      navDropdown.setAttribute('aria-hidden', String(isOpen));
      navTrigger.setAttribute('aria-expanded', String(!isOpen));
      navTrigger.setAttribute('aria-label', isOpen ? 'Open menu' : 'Close menu');
    });

    document.addEventListener('click', (e: MouseEvent) => {
      const target = e.target as Node;
      if (navDropdown.classList.contains('hidden')) return;
      if (navTrigger.contains(target) || navDropdown.contains(target)) return;
      navDropdown.classList.add('hidden');
      navDropdown.setAttribute('aria-hidden', 'true');
      navTrigger.setAttribute('aria-expanded', 'false');
      navTrigger.setAttribute('aria-label', 'Open menu');
    });

    document.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key !== 'Escape') return;
      if (navDropdown.classList.contains('hidden')) return;
      navDropdown.classList.add('hidden');
      navDropdown.setAttribute('aria-hidden', 'true');
      navTrigger.setAttribute('aria-expanded', 'false');
      navTrigger.setAttribute('aria-label', 'Open menu');
    });
  }
</script>
