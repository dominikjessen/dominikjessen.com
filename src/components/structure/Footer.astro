---
import EmailLink from '../ui/EmailLink.astro';
import Cursor from '../graph/Cursor.astro';

const year = new Date().getFullYear();

const links = [
  { label: 'GitHub', href: 'https://github.com/dominikjessen' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/dominikjessen/' },
  { label: 'CV', href: '/CV_DominikJessen.pdf' },
];

// Pine focus rings vanish on pine-deep, so the footer uses oat.
const focusRing = 'rounded-sm focus-visible:outline-2 focus-visible:outline-oat focus-visible:outline-offset-2';
const linkClass = `text-base text-canvas hover:underline decoration-oat underline-offset-4 ${focusRing}`;
---

<footer id="footer" class="pine-band w-full text-canvas">
  <div class="max-w-[1280px] mx-auto px-5 pt-14 pb-7 md:px-10 md:pt-[88px] md:pb-9 xl:px-[72px]">
    <div class="flex flex-col gap-12 lg:flex-row lg:items-end lg:justify-between">
      <div class="lg:max-w-[780px]">
        <p class="font-mono text-xs text-footer-muted">04 · next step</p>
        <h2 class="mt-6 font-display font-normal text-[42px] leading-[1.02] md:text-[68px] md:leading-none text-canvas">
          Building something interesting? <span class="italic text-oat">Let's grab coffee.</span>
        </h2>
        <div class="relative mt-9 inline-block">
          <EmailLink
            class={`inline-flex items-center gap-2.5 bg-oat text-charcoal text-[17px] leading-5 font-semibold px-[22px] py-[14px] rounded-[10px] ${focusRing}`}
          >
            <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M3 1.8v8.4L10 6z" fill="currentColor"></path></svg>
            Say hello
          </EmailLink>
          <!-- A visitor about to click. -->
          <Cursor name="you?" color="visitor" class="absolute left-[104px] top-[30px]" />
        </div>
      </div>

      <nav class="flex gap-14" aria-label="Footer">
        <div class="flex flex-col gap-2">
          <p class="mb-1 font-mono text-[11px] text-footer-muted">links</p>
          {
            links.map((link) => (
              <a href={link.href} target="_blank" rel="noopener noreferrer" class={linkClass}>
                {link.label}
              </a>
            ))
          }
        </div>
        <div class="flex flex-col gap-2">
          <p class="mb-1 font-mono text-[11px] text-footer-muted">say hello</p>
          <EmailLink class={linkClass}>Email</EmailLink>
        </div>
      </nav>
    </div>

    <div
      class="mt-16 md:mt-[68px] flex flex-col gap-2 border-t border-[rgb(247_246_241/0.16)] pt-4 md:flex-row md:items-center md:justify-between"
    >
      <p class="flex items-center gap-2.5 font-display text-xl text-canvas">
        <span class="text-xl leading-none" aria-hidden="true">👋🏻</span>Dominik Jessen
      </p>
      <p class="text-[13px] text-footer-muted">© {year} Dominik Jessen. All rights reserved.</p>
    </div>
  </div>
</footer>
