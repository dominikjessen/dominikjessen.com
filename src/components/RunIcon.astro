---
import type { RunIcon } from '../types/data';

export interface Props {
  icon: RunIcon;
  className?: string;
}

// Stroke icons on a 24×24 grid, one per achievement "run". Paths only; the <svg> below sets the stroke style.
const paths: Record<RunIcon, string> = {
  building:
    '<path d="M4 21V4.5a.5.5 0 0 1 .5-.5h9a.5.5 0 0 1 .5.5V21"/><path d="M14 9h5.5a.5.5 0 0 1 .5.5V21"/><path d="M2.5 21h19"/><path d="M7.5 8h3M7.5 12h3M7.5 16h3M17 13h.01M17 17h.01"/>',
  shield: '<path d="M12 3l7.5 3v5.2c0 4.6-3.1 8.4-7.5 9.8-4.4-1.4-7.5-5.2-7.5-9.8V6z"/><circle cx="12" cy="10.8" r="1.8"/><path d="M12 12.6v3"/>',
  gauge:
    '<path d="M3.5 17a8.5 8.5 0 1 1 17 0"/><path d="M12 17l4.2-5.2"/><circle cx="12" cy="17" r="1.3"/><path d="M6.5 11.5l1 .8M12 8.5v1.3M17.5 11.5l-1 .8"/>',
  layers: '<path d="M12 3.5l8.5 4.5-8.5 4.5-8.5-4.5z"/><path d="M3.5 12.2l8.5 4.5 8.5-4.5"/><path d="M3.5 16.4l8.5 4.5 8.5-4.5"/>',
  coins:
    '<ellipse cx="12" cy="6" rx="7" ry="2.6"/><path d="M5 6v4.2c0 1.4 3.1 2.6 7 2.6s7-1.2 7-2.6V6"/><path d="M5 10.2v4.2c0 1.4 3.1 2.6 7 2.6s7-1.2 7-2.6v-4.2"/><path d="M5 14.4v3.6c0 1.4 3.1 2.6 7 2.6s7-1.2 7-2.6v-3.6"/>',
  stack: '<rect x="8" y="3" width="12" height="15" rx="2"/><path d="M5 7v12a2 2 0 0 0 2 2h9"/><path d="M11 7.5h6M11 11h6M11 14.5h3.5"/>',
  chart: '<path d="M3.5 20.5h17"/><path d="M5 16l4.5-4.5 3.5 3 6.5-7"/><path d="M15 7.5h4.5V12"/>',
  route: '<circle cx="6" cy="18" r="2.2"/><circle cx="18" cy="6" r="2.2"/><path d="M8.2 18H15a3 3 0 0 0 0-6H9a3 3 0 0 1 0-6h6.8"/>',
  layout: '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 9h18M9 9v11"/><path d="M12.5 13h5M12.5 16.5h3"/>',
};

const { icon, className } = Astro.props as Props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  width="20"
  height="20"
  fill="none"
  stroke="currentColor"
  stroke-width="1.7"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  class:list={[className]}
  set:html={paths[icon]}
/>
