---
import '@fontsource-variable/signika';
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '@fontsource-variable/instrument-sans';
import '@fontsource-variable/jetbrains-mono';
import '@fontsource-variable/caveat';
import '../styles/tailwind.css';
import { Analytics } from '@vercel/analytics/react';
import Nav from '../components/structure/Nav.astro';
import Footer from '../components/structure/Footer.astro';
// Fonts above the fold (hero headline serif + body sans), preloaded so they don't swap in late.
// Same files the @fontsource CSS points at.
import serifRegular from '@fontsource/instrument-serif/files/instrument-serif-latin-400-normal.woff2?url';
import serifItalic from '@fontsource/instrument-serif/files/instrument-serif-latin-400-italic.woff2?url';
import sansVariable from '@fontsource-variable/instrument-sans/files/instrument-sans-latin-wght-normal.woff2?url';

interface Props {
  title: string;
  description?: string;
  showNav?: boolean;
  /** Menu pages: keeps the legacy Signika headings while the menu moves to the new design. */
  paper?: boolean;
}

const {
  title,
  description = "Hi, I'm Dominik, a product engineer at n8n. I turn real problems into software people enjoy using.",
  showNav = true,
  paper = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preload" href={serifRegular} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={serifItalic} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={sansVariable} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Dominik Jessen" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Hi, I'm Dominik. Product engineer, with a career graph from Uni Mannheim to n8n." />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body class:list={['bg-background text-foreground overflow-x-hidden', { paper }]}>
    {showNav && <Nav />}
    <main
      class:list={[
        'relative z-0 mx-auto pb-24 max-w-[1280px] px-5 md:px-10 xl:px-[72px]',
        // Pages with the fixed header bar clear it (14px + 54px mobile, 20px + 56px from md).
        showNav ? 'pt-[68px] md:pt-[76px]' : 'pt-12 md:pt-16',
      ]}
    >
      <slot />
    </main>
    <Footer />
    <Analytics />
  </body>
</html>

<style is:global>
  html {
    --background: 72 99% 98%;
    --foreground: 70 5% 7%;
    --foreground_lighter: 70 11% 11%;
    --primary: 119 19% 42%;
    --brass: 43 66% 66%;

    /* Semantic tints/surfaces */
    --primary-light: 119 25% 96%;
    --primary-soft: 119 20% 92%;
    --primary-muted: 119 19% 52%;
    --foreground-subtle: 70 5% 48%;
    --foreground-muted: 70 6% 35%;
    --foreground-soft: 70 8% 22%;
    --foreground-strong: 70 5% 12%;
    --foreground-surface: 70 5% 97%;
    --foreground-border: 70 5% 91%;
    /* Card surface: soft mix of primary + background, very light (for Work + Currently cards). Light: ~rgb(237,240,230). */
    --surface-card: 78 25% 92%;
    /* Deep bottle green + cream: the menu's filter bar and other "fine dining" accents. */
    --ink: 155 32% 17%;
    --ink-foreground: 45 45% 95%;

    /* Redesign palette (pine and oat). Hex so Tailwind opacity modifiers work via color-mix. */
    --canvas: #f5f2eb; /* page background */
    --canvas-dots: #d8d2c5; /* dot grid */
    --charcoal: #1a1a17; /* headings, strong text */
    --body: #3d3c36; /* paragraph text */
    --muted: #6a675e; /* labels, meta (5.1:1 on canvas) */
    --pine: #2f4a3a; /* primary: buttons, links, current step */
    --pine-deep: #22382b; /* footer, text on sage */
    --sage: #dfe7dd; /* engineering tint */
    --parchment: #f0e3cc; /* product tint; hero highlight */
    --parchment-text: #65573a; /* text on parchment (5.6:1) */
    --stone: #e6e3d6; /* neutral tint (Yes, Chef! screenshot bg) */
    --oat: #e9d9ba; /* accents on pine-deep; footer button */
    --wire: #8e8a7d; /* graph wires (decorative) */
    --wire-dash: #a9a597; /* dashed borders, timeline */
    --chip: #f1efe7; /* small chips and icon buttons */
    --card-head: #fbfaf6; /* panel header strip */
    --footer-muted: #b9b5a8; /* secondary text on pine-deep (6.1:1) */
    --visitor: #8e6538; /* the "you?" cursor */
  }

  html.dark {
    --background: 120 2% 10%;
    --foreground: 72 99% 98%;
    --foreground_lighter: 90 6% 93%;
    --primary: 120 19% 50%;
    --brass: 43 66% 66%;

    /* Semantic tints/surfaces (dark mode) */
    --primary-light: 120 19% 16%;
    --primary-soft: 120 19% 22%;
    --primary-muted: 120 19% 65%;
    --foreground-subtle: 40 6% 70%;
    --foreground-muted: 40 6% 70%;
    --foreground-soft: 90 6% 82%;
    --foreground-strong: 90 6% 96%;
    --foreground-surface: 120 2% 16%;
    --foreground-border: 120 2% 22%;
    --surface-card: 115 8% 18%;
    --ink: 152 18% 20%;
    --ink-foreground: 45 45% 95%;
  }

  ::selection {
    background: hsl(var(--primary));
    color: hsl(var(--background));
  }

  /* Oat dot grid and the body font, on every page. */
  body {
    background-color: var(--canvas);
    background-image: radial-gradient(var(--canvas-dots) 1.2px, transparent 1.3px);
    background-size: 24px 24px;
    font-family: var(--font-body);
  }

  /* Legacy heading style, kept for the menu's content until its headings are restyled (not the footer). */
  body.paper main h1,
  body.paper main h2 {
    font-family: 'Signika Variable', sans-serif;
    font-weight: 700;
  }

  a:hover {
    opacity: 80%;
  }

  .scroll-fade-in {
    animation: fade-in 2s linear both;
    animation-timeline: view();
    animation-range: entry 20% cover 50%;
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-fade-in {
      animation: none;
    }
  }

  @keyframes fade-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
</style>
