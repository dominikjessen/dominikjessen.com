---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { MealTypeIcon, TallyIcon, WhatsAppIcon } from '../../components/menu/MenuIcons';
import IngredientsPanel from '../../components/menu/IngredientsPanel';
import RecipeBadge from '../../components/menu/RecipeBadge';
import { chefRequestUrl } from '../../components/menu/chefRequest';
import { getMenuRecipes } from '../../components/menu/menuRecipes';
import {
  MEAL_TYPE_LABELS,
  RECIPE_EFFORT_LABELS,
  formatRecipeLabel,
  type MealType,
} from '../../types/recipes';

type NextDish = {
  id: string;
  title: string;
  mealType: MealType;
};

export async function getStaticPaths() {
  const recipes = await getMenuRecipes();
  return recipes.map((recipe, index) => {
    // Wrap around so the last dish points back to the first.
    const next = recipes[(index + 1) % recipes.length];
    return {
      params: { id: recipe.id },
      props: {
        recipe,
        next:
          next.id === recipe.id
            ? undefined
            : { id: next.id, title: next.data.title, mealType: next.data.mealType },
      },
    };
  });
}

interface Props {
  recipe: CollectionEntry<'recipes'>;
  next?: NextDish;
}

const { recipe, next } = Astro.props;
const { Content } = await render(recipe);
const {
  title,
  summary,
  mealType,
  categories,
  ingredients,
  tags,
  timeMinutes,
  servings,
  note,
  badges,
  marginNote,
  effort,
  pairsWith,
  timesMade,
  heroImage,
  heroImageAlt,
} = recipe.data;

// Time and servings live in the ingredients panel, where servings can be adjusted.
const details = [effort && RECIPE_EFFORT_LABELS[effort]].filter(
  (detail): detail is string => Boolean(detail)
);

// Categories and tags overlap (e.g. "vegetarian" in both) — show each label once.
const labels = [...new Set([...categories, ...tags])];
---

<Layout title={`${title} - Chez Dom`} showNav={false} description={summary}>
  <article class="flex flex-col gap-10 md:gap-14">
    <p>
      <a
        href="/menu"
        class="inline-flex items-center font-mono text-[13px] text-charcoal bg-white border border-charcoal/22 px-4 py-2.5 rounded-[10px] focus-visible:outline-2 focus-visible:outline-pine focus-visible:outline-offset-2"
      >
        ← menu
      </a>
    </p>

    {/* Title block with a square photo: beside it on wide screens, stacked above it on smaller ones. */}
    <div
      class="grid grid-cols-1 items-center gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,24rem)] lg:gap-12 xl:grid-cols-[minmax(0,1fr)_minmax(0,28rem)]"
    >
      {/* Until a recipe has a photo, a dashed placeholder of the same shape shows where it goes. */}
      {
        heroImage ? (
          <div class="w-full max-w-md overflow-hidden rounded-[14px] border border-charcoal/16 bg-stone shadow-[0_8px_20px_rgb(26_26_23/0.05)] lg:order-last lg:max-w-none">
            <Image
              src={heroImage}
              alt={heroImageAlt ?? ''}
              width={960}
              height={960}
              class="aspect-square w-full object-cover"
              loading="eager"
              fetchpriority="high"
            />
          </div>
        ) : (
          <div
            aria-hidden="true"
            class="aspect-square w-full max-w-md rounded-[14px] border-[1.5px] border-dashed border-wire-dash bg-white/40 lg:order-last lg:max-w-none"
          />
        )
      }

      <header class="flex flex-col gap-4">
        <div class="flex flex-wrap items-center gap-2 font-mono text-xs text-muted">
          <span class="rounded-[5px] bg-sage px-2 py-[3px] text-[11px] lowercase text-pine-deep">{MEAL_TYPE_LABELS[mealType]}</span>
          {badges.map((badge) => <RecipeBadge badge={badge} />)}
          {details.length > 0 && <span class="lowercase">{details.join(' · ')}</span>}
          {
            timesMade !== undefined && (
              <span class="inline-flex items-center gap-1.5">
                <TallyIcon className="size-4 text-pine" />
                made {timesMade}+ times
              </span>
            )
          }
        </div>
        <div class="flex flex-col gap-2">
          <h1 class="font-display font-normal text-[48px] md:text-[72px] leading-[0.98] tracking-[-0.02em] text-charcoal">{title}</h1>
          {marginNote && <p class="origin-left -rotate-2 font-hand text-2xl md:text-3xl text-pine">{marginNote}</p>}
        </div>
        <p class="text-[17px] leading-[1.65] md:text-[19px] md:leading-[1.72] text-body">{summary}</p>
        {
          labels.length > 0 && (
            <ul class="flex flex-wrap gap-2" aria-label="Categories and tags">
              {labels.map((label) => (
                <li class="rounded-[5px] bg-chip px-2 py-[3px] font-mono text-[11px] lowercase text-muted">{formatRecipeLabel(label)}</li>
              ))}
            </ul>
          )
        }
        {
          note && (
            <aside
              aria-label="Note from Dominik"
              class="mt-2 flex flex-col gap-1.5 rounded-[14px] border border-charcoal/16 bg-white px-5 py-4 shadow-[0_6px_16px_rgb(26_26_23/0.04)] md:px-6 md:py-5"
            >
              <span class="font-mono text-[11px] text-pine-deep">from dominik</span>
              <p class="text-base md:text-[17px] italic leading-relaxed text-body">{note}</p>
            </aside>
          )
        }
      </header>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,18rem)_1fr] gap-10 lg:gap-14 items-start">
      <section aria-labelledby="ingredients-heading">
        <IngredientsPanel client:load ingredients={ingredients} servings={servings} timeMinutes={timeMinutes} />
        {
          pairsWith && (
            <p class="mt-6 flex items-center gap-2 text-[15px] text-muted">
              <MealTypeIcon mealType="drink" className="size-5 shrink-0 text-pine" />
              <span>
                Pairs with <span class="text-charcoal">{pairsWith}</span>
              </span>
            </p>
          )
        }
      </section>

      <section aria-labelledby="method-heading" class="recipe-method min-w-0">
        <h2 id="method-heading" class="mb-6 font-display font-normal text-[32px] md:text-[40px] leading-none text-charcoal">Method</h2>
        <div class="text-[17px] md:text-[19px] leading-[1.65] text-body">
          <Content />
        </div>
      </section>
    </div>

    {/* Ask the chef once the recipe has done its job, rather than before anyone's read it. */}
    <section
      aria-label="Ask the chef"
      class="flex flex-col items-center gap-5 rounded-[14px] bg-parchment px-6 py-8 text-center sm:flex-row sm:justify-between sm:px-10 sm:text-left"
    >
      <div class="flex flex-col gap-1">
        <p class="font-hand text-3xl md:text-4xl text-pine">Fancy this one?</p>
        <p class="text-base md:text-[17px] text-body">Send me a message and I'll put it on the menu next time.</p>
      </div>
      <a
        href={chefRequestUrl(title)}
        target="_blank"
        rel="noopener noreferrer"
        class="group inline-flex shrink-0 items-center gap-2.5 rounded-[10px] bg-pine px-5 py-[13px] text-base font-semibold leading-5 text-white transition duration-200 ease-out hover:-translate-y-0.5 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-pine"
      >
        <WhatsAppIcon className="size-5 transition-transform duration-300 ease-out group-hover:-rotate-12 group-hover:scale-110" />
        Have chef make you this
        <span class="sr-only"> (opens WhatsApp)</span>
      </a>
    </section>
  </article>

  <!-- Recipe pages end in the menu's pine band: the way back, and the next dish. -->
  <nav slot="footer" aria-label="More from the menu" class="pine-band w-full text-canvas">
    <div
      class="max-w-[1280px] mx-auto flex flex-col gap-8 px-5 py-14 sm:flex-row sm:items-center sm:justify-between md:px-10 md:py-16 xl:px-[72px]"
    >
      <p class="flex flex-wrap gap-3">
        <a
          href="/menu"
          class="inline-flex items-center font-mono text-[13px] text-charcoal bg-oat px-4 py-2.5 rounded-[10px] focus-visible:outline-2 focus-visible:outline-oat focus-visible:outline-offset-2"
        >
          ← back to menu
        </a>
        <a
          href="/"
          class="inline-flex items-center font-mono text-[13px] text-canvas border border-canvas/25 px-4 py-2.5 rounded-[10px] focus-visible:outline-2 focus-visible:outline-oat focus-visible:outline-offset-2"
        >
          go home
        </a>
      </p>
      {
        next && (
          <a
            href={`/menu/${next.id}`}
            class="group flex flex-col gap-1 rounded-[14px] border border-canvas/15 bg-canvas/[0.06] px-6 py-4 transition duration-200 ease-out hover:bg-canvas/10 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-oat sm:min-w-72 sm:text-right"
          >
            <span class="font-mono text-[11px] lowercase text-footer-muted">next up · {MEAL_TYPE_LABELS[next.mealType]}</span>
            <span class="font-display text-[26px] md:text-[30px] leading-tight text-canvas">
              {next.title}
              <span aria-hidden class="inline-block text-oat transition duration-150 group-hover:translate-x-1">→</span>
            </span>
          </a>
        )
      }
    </div>
  </nav>
</Layout>

<style>
  .recipe-method :global(p) {
    margin-bottom: 1rem;
  }

  .recipe-method :global(p:last-child) {
    margin-bottom: 0;
  }

  .recipe-method :global(ul) {
    margin: 0 0 1rem;
    padding-left: 1.25rem;
  }

  .recipe-method :global(ul > li) {
    margin-bottom: 0.5rem;
  }

  /* Numbered steps: big pine serif numbers so you can find your place mid-cook. */
  .recipe-method :global(ol) {
    list-style: none;
    counter-reset: step;
    margin: 0 0 1rem;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  /* Number and step text sit in a two-column grid, aligned on the first line's baseline. */
  .recipe-method :global(ol > li) {
    counter-increment: step;
    display: grid;
    grid-template-columns: 2.75rem minmax(0, 1fr);
    align-items: baseline;
  }

  .recipe-method :global(ol > li::before) {
    content: counter(step);
    font-family: var(--font-display);
    font-size: 2em;
    line-height: 1;
    color: var(--pine);
    font-variant-numeric: tabular-nums;
  }
</style>
