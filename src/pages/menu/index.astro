---
import Layout from '../../layouts/Layout.astro';
import MenuBackdrop from '../../components/menu/MenuBackdrop.astro';
import { getMenuRecipes } from '../../components/menu/menuRecipes';
import MenuBrowse from '../../sections/menuBrowse';
import { RecipeTagIcon } from '../../components/menu/MenuIcons';
import { MENU_ICON_TAGS, formatRecipeLabel, menuIconTags, type RecipeListItem } from '../../types/recipes';

/** How many ingredients make up the fallback menu line when no `menuLine` is set. */
const MENU_LINE_INGREDIENTS = 4;

const collection = await getMenuRecipes();

const recipes: RecipeListItem[] = collection.map(({ id, data }) => ({
  id,
  title: data.title,
  summary: data.summary,
  mealType: data.mealType,
  tags: data.tags,
  badges: data.badges,
  marginNote: data.marginNote,
  menuLine:
    data.menuLine ??
    data.ingredients
      .filter((ingredient) => !ingredient.optional)
      .slice(0, MENU_LINE_INGREDIENTS)
      .map((ingredient) => ingredient.name)
      .join(', '),
  ingredientNames: data.ingredients.map((ingredient) => ingredient.name),
  timeMinutes: data.timeMinutes,
}));

// The key only explains icons that actually appear on the menu.
const usedTags = new Set(recipes.flatMap((recipe) => menuIconTags(recipe.tags)));
const legendTags = MENU_ICON_TAGS.filter((tag) => usedTags.has(tag));
---

<Layout title="Chez Dom" showNav={false}>
  <div class="relative flex flex-col gap-10 md:gap-14">
    <MenuBackdrop />
    <!-- Masthead in the homepage's language: a path chip, a live status pill and a serif name.
         `data-keep-clear` marks text that background doodles must not sit behind (see MenuBackdrop). -->
    <header class="flex flex-col items-center gap-4 px-4 py-8 text-center md:py-12">
      <p data-keep-clear class="flex items-center gap-3 font-mono text-xs text-muted">
        <span class="rounded-md bg-chip px-2 py-1">~/menu</span>
        <span class="inline-flex items-center gap-1.5 rounded-full bg-sage px-2.5 py-1 text-[11px] text-pine-deep">
          <span class="size-[7px] rounded-full bg-pine animate-pulse-soft" aria-hidden="true"></span>
          open most nights
        </span>
      </p>
      <h1
        data-keep-clear
        class="font-display font-normal text-[64px] md:text-[96px] leading-[0.95] tracking-[-0.02em] text-charcoal"
      >
        Chez <span class="italic">Dom</span>
      </h1>
      <p data-keep-clear class="max-w-xl text-[17px] leading-[1.65] md:text-[19px] md:leading-[1.72] text-body">
        Pull up a chair and I'll <strong class="font-semibold text-charcoal bg-parchment px-1 py-px rounded-[3px] box-decoration-clone"
          >whip us something up.</strong
        >
      </p>
    </header>

    <MenuBrowse client:load recipes={recipes} />
  </div>

  <!-- The menu ends in its own pine band (key, fine print, way home) instead of the site footer. -->
  <footer slot="footer" class="pine-band w-full text-canvas">
    <div class="max-w-[1280px] mx-auto flex flex-col items-center gap-8 px-5 py-14 text-center md:px-10 md:py-16 xl:px-[72px]">
      {
        legendTags.length > 0 && (
          <ul aria-label="Key" class="flex flex-wrap justify-center gap-x-6 gap-y-2 font-mono text-xs lowercase text-footer-muted">
            {legendTags.map((tag) => (
              <li class="inline-flex items-center gap-1.5">
                <RecipeTagIcon tag={tag} className="size-4 text-oat" />
                {formatRecipeLabel(tag)}
              </li>
            ))}
          </ul>
        )
      }
      <ul aria-label="The fine print" class="flex flex-col gap-1.5 text-sm italic text-canvas/80">
        <li>* Service not included. Doing the dishes very much appreciated.</li>
        <li>** Kitchen closes when the wine runs out.</li>
        <li>*** Don't forget to give your compliments to the chef ;)</li>
      </ul>
      <a
        href="/"
        class="inline-flex items-center font-mono text-[13px] text-charcoal bg-oat px-4 py-2.5 rounded-[10px] focus-visible:outline-2 focus-visible:outline-oat focus-visible:outline-offset-2"
      >
        ← go home
      </a>
    </div>
  </footer>
</Layout>
