---
import '@fontsource-variable/caveat';
import Layout from '../../layouts/Layout.astro';
import { getMenuRecipes } from '../../components/menu/menuRecipes';
import MenuBrowse from '../../sections/menuBrowse';
import type { RecipeListItem } from '../../types/recipes';

/** How many ingredients make up the fallback menu line when no `menuLine` is set. */
const MENU_LINE_INGREDIENTS = 4;

const collection = await getMenuRecipes();

const recipes: RecipeListItem[] = collection.map(({ id, data }) => ({
  id,
  title: data.title,
  summary: data.summary,
  mealType: data.mealType,
  tags: data.tags,
  badges: data.badges,
  marginNote: data.marginNote,
  menuLine:
    data.menuLine ??
    data.ingredients
      .filter((ingredient) => !ingredient.optional)
      .slice(0, MENU_LINE_INGREDIENTS)
      .map((ingredient) => ingredient.name)
      .join(', '),
  ingredientNames: data.ingredients.map((ingredient) => ingredient.name),
  timeMinutes: data.timeMinutes,
}));
---

<Layout title="Chez Dom" showNav={false} paper>
  <div class="flex flex-col gap-10 md:gap-14">
    <!-- Printed-menu masthead: double rules, name, house line, tagline, handwritten sign-off. -->
    <header
      class="flex flex-col items-center gap-4 border-y-[5px] border-double border-primary/30 px-4 py-10 text-center md:py-14"
    >
      <h1 class="text-6xl md:text-7xl lg:text-8xl text-primary leading-none">Chez Dom</h1>
      <p class="font-sans text-xs md:text-sm font-semibold uppercase tracking-[0.3em] text-foreground-subtle">
        Open most nights
      </p>
      <div class="mt-2 flex flex-col items-center">
        <p
          class="max-w-xl font-hand text-2xl md:text-3xl text-foreground-subtle leading-snug motion-safe:animate-menu-fade-up"
        >
          Pull up a chair and I'll whip us something up.
        </p>
        <!-- The signature writes itself in after the tagline appears. -->
        <p
          class="-mt-1 translate-x-16 -rotate-6 font-hand text-4xl md:translate-x-32 md:text-5xl text-primary dark:text-primary-muted motion-safe:animate-write-in"
        >
          ~Dom
        </p>
      </div>
    </header>

    <MenuBrowse client:load recipes={recipes} />

    <!-- Fine print, like the bottom of a real menu. Closes with the same double rule as the masthead. -->
    <footer
      class="flex flex-col items-center gap-8 border-t-[5px] border-double border-primary/30 pt-8 text-center"
    >
      <ul aria-label="The fine print" class="flex flex-col gap-1.5 text-sm italic text-foreground-subtle">
        <li>* Service not included. Doing the dishes very much appreciated.</li>
        <li>** Kitchen closes when the wine runs out.</li>
        <li>*** Don't forget to give your compliments to the chef ;)</li>
      </ul>
      <a
        href="/"
        class="font-signika text-lg text-primary hover:text-primary-muted dark:text-foreground-soft dark:hover:text-foreground-strong"
      >
        ← Go home
      </a>
    </footer>
  </div>
</Layout>
