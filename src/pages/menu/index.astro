---
import '@fontsource-variable/caveat';
// Full axes (wght, opsz, SOFT, WONK) for the soft, slightly wonky italic masthead name.
import '@fontsource-variable/fraunces/full-italic.css';
import Layout from '../../layouts/Layout.astro';
import MenuBackdrop from '../../components/menu/MenuBackdrop.astro';
import { getMenuRecipes } from '../../components/menu/menuRecipes';
import MenuBrowse from '../../sections/menuBrowse';
import type { RecipeListItem } from '../../types/recipes';

/** How many ingredients make up the fallback menu line when no `menuLine` is set. */
const MENU_LINE_INGREDIENTS = 4;

const collection = await getMenuRecipes();

const recipes: RecipeListItem[] = collection.map(({ id, data }) => ({
  id,
  title: data.title,
  summary: data.summary,
  mealType: data.mealType,
  tags: data.tags,
  badges: data.badges,
  marginNote: data.marginNote,
  menuLine:
    data.menuLine ??
    data.ingredients
      .filter((ingredient) => !ingredient.optional)
      .slice(0, MENU_LINE_INGREDIENTS)
      .map((ingredient) => ingredient.name)
      .join(', '),
  ingredientNames: data.ingredients.map((ingredient) => ingredient.name),
  timeMinutes: data.timeMinutes,
}));
---

<Layout title="Chez Dom" showNav={false} paper>
  <div class="relative flex flex-col gap-10 md:gap-14">
    <MenuBackdrop />
    <!-- Menu masthead: serif name with a brass swash, house line, handwritten tagline and sign-off.
         `data-keep-clear` marks text that background doodles must not sit behind (see MenuBackdrop). -->
    <header class="flex flex-col items-center gap-2 px-4 py-8 text-center md:py-12">
      <!-- `!` on family and weight: Layout.astro's unlayered h1 rule would otherwise beat Tailwind's layered utilities. -->
      <h1
        data-keep-clear
        class="font-fraunces! font-medium! italic tracking-wide text-6xl md:text-7xl lg:text-8xl text-primary leading-none [font-variation-settings:'SOFT'_100,'WONK'_1]"
      >
        Chez Dom
      </h1>
      <!-- Brass swash under the name; draws itself in just before the ~Dom signature does. -->
      <svg
        data-keep-clear
        viewBox="0 0 160 12"
        fill="none"
        aria-hidden="true"
        class="-mt-1 w-40 md:w-56 text-brass motion-safe:animate-write-in"
        style="animation-delay: 150ms"
      >
        <path
          d="M4 8C40 2 90 2 156 6"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          vector-effect="non-scaling-stroke"
        />
      </svg>
      <p
        data-keep-clear
        class="mt-2 font-sans text-xs md:text-sm font-semibold uppercase tracking-[0.3em] text-foreground-subtle"
      >
        Open most nights
      </p>
      <div class="mt-3 flex flex-col items-center">
        <p
          data-keep-clear
          class="max-w-xl font-hand text-2xl md:text-3xl text-foreground-subtle leading-snug motion-safe:animate-menu-fade-up"
        >
          Pull up a chair and I'll whip us something up.
        </p>
        <!-- The signature writes itself in after the tagline appears. -->
        <p
          data-keep-clear
          class="-mt-1 translate-x-16 -rotate-6 font-hand text-4xl md:translate-x-32 md:text-5xl text-primary dark:text-primary-muted motion-safe:animate-write-in"
        >
          ~Dom
        </p>
      </div>
    </header>

    <MenuBrowse client:load recipes={recipes} />

    <!-- Fine print, like the bottom of a real menu. -->
    <footer class="flex flex-col items-center gap-8 pt-8 text-center">
      <ul aria-label="The fine print" class="flex flex-col gap-1.5 text-sm italic text-foreground-subtle">
        <li>* Service not included. Doing the dishes very much appreciated.</li>
        <li>** Kitchen closes when the wine runs out.</li>
        <li>*** Don't forget to give your compliments to the chef ;)</li>
      </ul>
      <a
        href="/"
        class="font-signika text-lg text-primary hover:text-primary-muted dark:text-foreground-soft dark:hover:text-foreground-strong"
      >
        ← Go home
      </a>
    </footer>
  </div>
</Layout>
