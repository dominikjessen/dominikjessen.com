---
import { getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import MenuBrowse from '../../sections/menuBrowse';
import type { RecipeListItem } from '../../types/recipes';

const collection = (await getCollection('recipes', ({ data }) => !data.draft)).sort((a, b) =>
  a.data.title.localeCompare(b.data.title)
);

const recipes: RecipeListItem[] = await Promise.all(
  collection.map(async (recipe) => {
    const optimized = await getImage({
      src: recipe.data.heroImage,
      width: 720,
      height: 480,
    });

    return {
      id: recipe.id,
      title: recipe.data.title,
      summary: recipe.data.summary,
      mealType: recipe.data.mealType,
      categories: recipe.data.categories,
      ingredientNames: recipe.data.ingredients.map((ingredient) => ingredient.name),
      timeMinutes: recipe.data.timeMinutes,
      heroImageSrc: optimized.src,
      heroImageAlt: recipe.data.heroImageAlt,
    };
  })
);
---

<Layout title="Dominik Jessen - Menu" showNav={false}>
  <div class="flex flex-col gap-12 md:gap-16">
    <header class="flex flex-col gap-4 max-w-2xl">
      <h1 class="text-5xl md:text-6xl lg:text-7xl text-primary leading-none">What's cooking</h1>
      <p class="text-xl md:text-2xl text-foreground_lighter leading-relaxed">
        The dishes I actually make — for friends at the table, or whoever scanned the QR code.
      </p>
    </header>

    <MenuBrowse client:load recipes={recipes} />

    <p class="pt-4">
      <a
        href="/"
        class="font-signika text-lg text-primary hover:text-primary-muted dark:text-foreground-soft dark:hover:text-foreground-strong"
      >
        ← Go home
      </a>
    </p>
  </div>
</Layout>
