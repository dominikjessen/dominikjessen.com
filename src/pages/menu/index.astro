---
import { getImage } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import { getMenuRecipes } from '../../components/menu/menuRecipes';
import MenuBrowse from '../../sections/menuBrowse';
import type { RecipeListItem } from '../../types/recipes';

/** How many ingredients make up the fallback menu line when no `menuLine` is set. */
const MENU_LINE_INGREDIENTS = 4;

const collection = await getMenuRecipes();

const recipes: RecipeListItem[] = await Promise.all(
  collection.map(async ({ id, data }) => {
    // Only the Chef's pick shows a photo on the index.
    const image =
      data.featured && data.heroImage
        ? await getImage({ src: data.heroImage, width: 960, height: 720 })
        : undefined;

    return {
      id,
      title: data.title,
      summary: data.summary,
      mealType: data.mealType,
      tags: data.tags,
      featured: data.featured,
      menuLine:
        data.menuLine ??
        data.ingredients
          .filter((ingredient) => !ingredient.optional)
          .slice(0, MENU_LINE_INGREDIENTS)
          .map((ingredient) => ingredient.name)
          .join(', '),
      ingredientNames: data.ingredients.map((ingredient) => ingredient.name),
      timeMinutes: data.timeMinutes,
      heroImageSrc: image?.src,
      heroImageAlt: data.heroImageAlt,
    };
  })
);
---

<Layout title="Dominik Jessen - Menu" showNav={false} paper>
  <div class="flex flex-col gap-10 md:gap-14">
    <header class="flex flex-col gap-4 max-w-2xl">
      <h1 class="text-5xl md:text-6xl lg:text-7xl text-primary leading-none">What's cooking</h1>
      <p class="text-lg md:text-2xl text-foreground_lighter leading-relaxed">
        The dishes I actually make — for friends at the table, or whoever scanned the QR code.
      </p>
    </header>

    <MenuBrowse client:load recipes={recipes} />

    <p class="pt-4">
      <a
        href="/"
        class="font-signika text-lg text-primary hover:text-primary-muted dark:text-foreground-soft dark:hover:text-foreground-strong"
      >
        ← Go home
      </a>
    </p>
  </div>
</Layout>
