---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import RecipeCard from '../../components/menu/RecipeCard.astro';

const recipes = (await getCollection('recipes', ({ data }) => !data.draft)).sort((a, b) =>
  a.data.title.localeCompare(b.data.title)
);
---

<Layout title="Dominik Jessen - Menu" showNav={false}>
  <div class="flex flex-col gap-12 md:gap-16">
    <header class="flex flex-col gap-4 max-w-2xl">
      <h1 class="text-5xl md:text-6xl lg:text-7xl text-primary leading-none">What's cooking</h1>
      <p class="text-xl md:text-2xl text-foreground_lighter leading-relaxed">
        The dishes I actually make — for friends at the table, or whoever scanned the QR code.
      </p>
      <p class="text-base md:text-lg text-foreground-subtle">
        {recipes.length} {recipes.length === 1 ? 'dish' : 'dishes'} on the board
      </p>
    </header>

    <section aria-label="Recipes" class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-6 md:gap-8">
      {recipes.map((recipe) => <RecipeCard recipe={recipe} />)}
    </section>

    <p class="pt-4">
      <a
        href="/"
        class="font-signika text-lg text-primary hover:text-primary-muted dark:text-foreground-soft dark:hover:text-foreground-strong"
      >
        ← Go home
      </a>
    </p>
  </div>
</Layout>
