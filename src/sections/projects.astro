---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import projects from '../data/projects.json';
import type { Project } from '../types/data';

// Screenshots live in src/images/projects/ so Astro can resize them and serve WebP.
const screenshots = import.meta.glob<{ default: ImageMetadata }>('../images/projects/**/*.{png,PNG,jpg,jpeg,webp}', { eager: true });
const screenshot = (path: string) => screenshots[`../images/projects/${path}`]?.default;

// Each project reads as a small workflow: IN → project → OUT.
const items = projects as Project[];

const TINT: Record<Project['tint'], string> = {
  parchment: 'bg-parchment',
  stone: 'bg-stone',
  sage: 'bg-sage',
};

// An emoji-only IN (Cinemojis) gets a spoken label instead of the raw emoji.
const NUMBER_WORDS = ['', 'one', 'two', 'three', 'four', 'five', 'six'];
const emojiLabel = (text: string) => {
  if (/\p{L}|\p{N}/u.test(text)) return undefined;
  const count = [...new Intl.Segmenter('en', { granularity: 'grapheme' }).segment(text.trim())].length;
  return `${NUMBER_WORDS[count] ?? count} emoji`;
};

const focusRing = 'focus-visible:outline-2 focus-visible:outline-pine focus-visible:outline-offset-2';
---

<section id="projects" class="pb-16 lg:pb-28">
  <header class="flex flex-col gap-2">
    <p class="font-mono text-xs text-muted">01 · side projects</p>
    <h2 class="font-display font-normal text-heading md:text-heading-lg text-charcoal">
      Side <span class="italic">projects</span>
    </h2>
  </header>

  <ul class="mt-7.5 flex flex-col gap-9 xl:gap-12">
    {
      items.map((project) => {
        const inLabel = emojiLabel(project.input);
        return (
          <li class="flex flex-col items-start xl:flex-row xl:items-center">
            {/* IN */}
            <div class="inline-flex items-baseline gap-2 px-3 py-2.25 xl:flex xl:flex-col xl:items-start xl:gap-0.5 xl:w-40 xl:shrink-0 xl:px-3.5 xl:py-3 bg-white border border-dashed border-wire-dash rounded-button">
              <span class="font-mono text-[10px] text-muted">IN</span>
              <span class="text-[15px] font-semibold text-charcoal" role={inLabel ? 'img' : undefined} aria-label={inLabel}>
                {project.input}
              </span>
            </div>

            {/* IN → card */}
            <svg class="ml-6 xl:hidden" width="12" height="26" viewBox="0 0 12 26" fill="none" aria-hidden="true">
              <path d="M6 0V26" class="animate-flow" stroke="var(--wire)" stroke-width="1.6" stroke-dasharray="6 6" />
            </svg>
            <svg class="hidden xl:block shrink-0" width="44" height="12" viewBox="0 0 44 12" fill="none" aria-hidden="true">
              <path d="M0 6H44" class="animate-flow" stroke="var(--wire)" stroke-width="1.6" stroke-dasharray="6 6" />
            </svg>

            {/* Card */}
            <article class="w-full xl:flex-1 xl:min-w-0 flex flex-col md:flex-row gap-5.5 p-4 md:p-5.5 bg-white border border-charcoal/16 rounded-card shadow-card">
              <div class="flex flex-col gap-2.5 md:flex-1 md:min-w-0">
                <h3 class="font-display font-normal text-[28px] md:text-[32px] leading-[1.05] text-charcoal">{project.name}</h3>
                <p class="text-[15px] leading-[1.6] text-body">{project.tagline}</p>
                {project.stat && (
                  <p class="inline-flex items-center gap-1.5 self-start rounded-full bg-sage px-2.5 py-1 font-mono text-label text-pine-deep">
                    <span class="size-1.5 rounded-full bg-pine" aria-hidden="true" />
                    {project.stat}
                  </p>
                )}
                {project.techStack && (
                  <p class="font-mono text-label leading-relaxed text-muted lowercase">{project.techStack.join(' · ')}</p>
                )}
                <div class="mt-1 flex flex-wrap items-stretch gap-2.5">
                  {project.url && (
                    <a
                      href={project.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class:list={['inline-flex items-center bg-pine text-white text-sm font-semibold px-3.5 py-2.25 rounded-lg', focusRing]}
                    >
                      Visit site<span class="sr-only">: {project.name}</span>
                      <span aria-hidden="true">&nbsp;→</span>
                    </a>
                  )}
                  {project.github && (
                    <a
                      href={project.github}
                      target="_blank"
                      rel="noopener noreferrer"
                      class:list={['inline-flex items-center font-mono text-xs text-charcoal border border-charcoal/20 px-3 rounded-lg', focusRing]}
                    >
                      github<span class="sr-only">: {project.name} source code</span>
                    </a>
                  )}
                </div>
              </div>
              {project.imgSrc && screenshot(project.imgSrc) && (
                <Image
                  src={screenshot(project.imgSrc)!}
                  alt={project.imgAlt ?? ''}
                  widths={[360, 580, 720, 1040]}
                  sizes="(min-width: 768px) 290px, calc(100vw - 72px)"
                  loading="lazy"
                  class:list={[
                    'order-first md:order-last w-full h-45 md:w-72.5 md:h-46 md:shrink-0 rounded-[9px] object-cover object-left-top',
                    TINT[project.tint],
                  ]}
                />
              )}
            </article>

            {/* card → OUT */}
            <svg class="ml-6 xl:hidden" width="12" height="26" viewBox="0 0 12 26" fill="none" aria-hidden="true">
              <path d="M6 0V26" class="animate-flow" stroke="var(--pine)" stroke-width="1.6" stroke-dasharray="6 6" />
            </svg>
            <svg class="hidden xl:block shrink-0" width="44" height="12" viewBox="0 0 44 12" fill="none" aria-hidden="true">
              <path d="M0 6H44" class="animate-flow" stroke="var(--pine)" stroke-width="1.6" stroke-dasharray="6 6" />
            </svg>

            {/* OUT */}
            <div class="inline-flex items-baseline gap-2 px-3 py-2.25 xl:flex xl:flex-col xl:items-start xl:gap-0.5 xl:w-40 xl:shrink-0 xl:px-3.5 xl:py-3 bg-sage rounded-button">
              <span class="font-mono text-[10px] text-pine-deep">OUT</span>
              <span class="text-[15px] font-semibold text-charcoal">{project.output}</span>
            </div>
          </li>
        );
      })
    }
  </ul>
</section>
