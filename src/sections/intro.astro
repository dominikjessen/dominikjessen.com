---
import AchievementCards from '../components/AchievementCards';
---

<section id="intro" class="grid grid-cols-1 lg:grid-cols-2 gap-8 justify-end items-center pt-12 mt-24">
  <div class="flex flex-col gap-6">
    <span class="text-7xl animate-wave origin-[70%_70%] w-fit intersect-target">👋🏻</span>
    <h1 class="font-bold text-7xl mb-4 text-primary intersect-target">Hi, I'm Dominik.</h1>
    <p class="text-foreground_lighter text-2xl leading-relaxed">
      I'm a <span class="text-primary font-signika">product engineer</span>. I used to build roadmaps and led 10+ person teams as a PM, then went back to building so I could build and ship. Now I do both: <span class="text-primary font-signika">turn real problems into software people enjoy using.</span>
    </p>
    <p class="text-foreground_lighter text-2xl leading-relaxed">
      Currently, I'm a senior product engineer at <a href="https://n8n.io/" target="_blank" class="text-primary font-signika">n8n</a> helping people
      automate all their workflows with ease.
    </p>
  </div>
  <AchievementCards client:load className="flex flex-col mx-auto"  />
</section>
