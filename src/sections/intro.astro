---
import CareerGraph from '../components/graph/CareerGraph.astro';
---

<section
  id="intro"
  class="grid grid-cols-1 gap-12 pt-10 pb-11 md:pt-[72px] md:pb-[104px] xl:grid-cols-[minmax(0,540px)_550px] xl:justify-between"
>
  <div class="flex flex-col max-w-[640px]">
    <div class="flex items-start gap-[14px]">
      <span class="text-[44px] md:text-[56px] leading-none animate-wave origin-[70%_70%]" role="img" aria-label="Waving hand">👋🏻</span>
    </div>

    <h1 class="mt-3 font-display font-normal text-[58px] md:text-[96px] leading-[0.98] tracking-[-0.02em] text-charcoal xl:whitespace-nowrap">
      Hi, I'm <span class="italic">Dominik.</span>
    </h1>

    <p class="mt-[30px] text-[17px] leading-[1.65] md:text-[19px] md:leading-[1.72] text-body">
      I'm a <strong class="font-semibold text-charcoal">product engineer</strong>. I used to build roadmaps and led 10+ person teams as a PM, then went
      back to building so I could build and ship. Now I do both: <strong
        class="font-semibold text-charcoal bg-parchment px-1 py-px rounded-[3px] box-decoration-clone"
        >turn real problems into software people enjoy using.</strong
      >
    </p>
    <p class="mt-4 text-[17px] leading-[1.65] md:text-[19px] md:leading-[1.72] text-body">
      Currently, I'm a senior product engineer at <a
        href="https://n8n.io/"
        target="_blank"
        rel="noopener noreferrer"
        class="font-semibold text-charcoal rounded-sm focus-visible:outline-2 focus-visible:outline-pine focus-visible:outline-offset-2">n8n</a
      > helping people automate all their workflows with ease.
    </p>

    <!-- Two low-commitment actions: read the CV or look at the code. (Say hello lives in the footer.) -->
    <div class="mt-8 flex flex-wrap items-stretch gap-[14px]">
      <a
        href="/CV_DominikJessen.pdf"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2.5 bg-pine text-white text-base leading-5 font-semibold px-5 py-[13px] rounded-[10px] focus-visible:outline-2 focus-visible:outline-pine focus-visible:outline-offset-2"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"></path><path d="M14 3v5h5M9 13h6M9 17h4"></path>
        </svg>
        cv.pdf
      </a>
      <a
        href="https://github.com/dominikjessen"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 font-mono text-[13px] text-charcoal bg-white border border-charcoal/22 px-4 rounded-[10px] focus-visible:outline-2 focus-visible:outline-pine focus-visible:outline-offset-2"
      >
        <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.68 0-1.25.45-2.28 1.19-3.08-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.8 1.19 1.83 1.19 3.08 0 4.41-2.69 5.38-5.26 5.67.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5z"></path>
        </svg>
        github
      </a>
    </div>
  </div>

  <!-- Career graph: vertical below md, two lanes from md (centred while the hero is stacked, right column at xl). -->
  <CareerGraph className="xl:w-[550px] xl:justify-self-end" />
</section>
